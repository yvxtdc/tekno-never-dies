# Configuration du CMS Tekno Never Dies — copier en cms/.env (jamais versionné) et adapter.
# Aucune valeur secrète n'est nécessaire ici : les mots de passe sont hachés en base, les sessions
# sont aléatoires. Les accès GitHub passent par la clé SSH de déploiement du serveur (voir docs).

# Adresse publique de l'administration (sert aux contrôles d'origine et aux liens d'aperçu).
# En production : https://… derrière un proxy HTTPS (Caddy, nginx). Les cookies deviennent Secure.
CMS_PUBLIC_URL=http://localhost:8787

# Écoute du serveur Node (laisser 127.0.0.1 derrière un proxy).
CMS_HOST=127.0.0.1
CMS_PORT=8787

# Mettre 1 seulement derrière un proxy de confiance (adresse IP réelle via X-Forwarded-For).
CMS_TRUST_PROXY=0

# Données persistantes : base SQLite, images importées, sauvegardes (hors du dépôt Git).
CMS_DATA_DIR=.cms-data

# Copie de travail du site où la mise en ligne écrit (par défaut : ce dépôt).
CMS_SITE_DIR=.

# Mise en ligne : files (écrit les fichiers), commit (+ commit Git), push (+ envoi sur GitHub).
CMS_PUBLISH_MODE=files
CMS_GIT_REMOTE=origin
CMS_GIT_BRANCH=main
CMS_GIT_AUTHOR_NAME=CMS Tekno Never Dies
CMS_GIT_AUTHOR_EMAIL=cms@teknoneverdies.fr

# Plans OpenStreetMap des nouveaux lieux pendant la mise en ligne (réseau requis).
CMS_RUN_MAPS=1

# Sessions : déconnexion après inactivité (minutes) et durée maximale (heures).
CMS_SESSION_IDLE_MINUTES=120
CMS_SESSION_MAX_HOURS=12

# Taille maximale d'une image importée (Mo).
CMS_MAX_UPLOAD_MB=20

# Tâches de fond : publications programmées, sauvegarde automatique, purge des sessions.
CMS_SCHEDULER=1
CMS_AUTO_PUBLISH_SCHEDULED=1
CMS_BACKUP_EVERY_HOURS=24
CMS_BACKUP_KEEP=30

# info, ou silent
CMS_LOG_LEVEL=info
