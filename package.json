{
  "name": "tekno-never-dies-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de l'association Tekno Never Dies (TND6TEM) : pages statiques, données en JavaScript, étoiles chrome en 3D (Three.js) sur l'accueil, et CMS d'administration (cms/).",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve .",
    "partials": "node tools/sync-partials.mjs && node tools/langues.mjs",
    "validate": "node tools/validate.mjs",
    "calendar": "node tools/generate-calendar.mjs && node tools/event-pages.mjs && node tools/langues.mjs",
    "photos": "node tools/photos.mjs",
    "artistes": "node tools/artistes.mjs",
    "traductions": "node tools/i18n-pages.mjs",
    "langues": "node tools/langues.mjs",
    "plans": "node tools/maps.mjs",
    "cms": "node --disable-warning=ExperimentalWarning cms/server/index.mjs",
    "cms:admin": "node --disable-warning=ExperimentalWarning cms/bin/cms.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"cms/test/*.test.mjs\""
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
